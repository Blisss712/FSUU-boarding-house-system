# -------------------------------------------------------------
# Balay Urios (Serjon) Environment Configuration
# -------------------------------------------------------------

# Supabase Configuration
# Replace with your project details from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role key for the demo-data cleanup script (scripts/clean-demo-data.js)
# Keep this secret! Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------------------------
# AI Student-Needs Search (Google Gemini)
# -------------------------------------------------------------
# Create a free key at https://aistudio.google.com  ->  "Get API key"
# Then paste it below and restart `npm run dev`.
#
# The key is read by the local proxy in scripts/vite-ai-proxy.js, so it is NOT
# bundled into the browser build. Leave it empty to keep AI search off; the app
# still works and the panel explains how to finish the setup.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: model + endpoint overrides (defaults shown)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Fallback for static hosting only (no serverless proxy available).
# WARNING: a VITE_ variable is compiled into the browser bundle, so anyone can
# read this key. Restrict it to your domain first, or keep the proxy instead.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-3.6-flash

# -------------------------------------------------------------
# Map tiles (Leaflet + OpenStreetMap) — NO API key required
# -------------------------------------------------------------
# osm           = classic OpenStreetMap (default)
# carto-light   = muted light basemap (closest to a Google-Maps look)
# carto-voyager = soft coloured basemap
# Leave unset to use the default OpenStreetMap tiles.
# VITE_MAP_TILES=carto-light
